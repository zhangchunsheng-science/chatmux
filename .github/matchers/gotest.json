{
  "problemMatcher": [
    {
      "owner": "gotest-fail",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^\\s*--- FAIL: (.*)$",
          "file": "go.mod",
          "line": 1,
          "message": 1
        }
      ]
    },
    {
      "owner": "gotest-pkgfail",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^FAIL\\t(\\S+).*$",
          "file": "go.mod",
          "line": 3,
          "message": 1
        }
      ]
    },
    {
      "owner": "gotest-panic",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^panic: (.*)$",
          "file": "go.mod",
          "line": 5,
          "message": 1
        }
      ]
    }
  ]
}
