{
  "http": {
    "listen": "127.0.0.1:8080",
    "adminToken": "set-a-long-random-string-if-exposed"
  },
  "dataDir": "data",
  "skillsDir": "skills",
  "transcribe": { "enabled": true, "model": "whisper-1" },
  "defaultAgent": "helper",
  "channels": [
    {
      "type": "feishu",
      "name": "feishu",
      "options": {
        "appId": "cli_xxxx",
        "appSecret": "xxxx",
        "mode": "ws",
        "allowUsers": ["ou_xxxx"],
        "allowChats": []
      }
    },
    {
      "type": "dingtalk",
      "name": "dingtalk",
      "options": {
        "clientId": "dingxxxx",
        "clientSecret": "xxxx",
        "allowUsers": []
      }
    },
    {
      "type": "wecom",
      "name": "wecom",
      "options": {
        "corpId": "wwxxxx",
        "agentId": 1000002,
        "secret": "xxxx",
        "token": "xxxx",
        "encodingAesKey": "43chars",
        "callbackPath": "/wecom/callback",
        "allowUsers": []
      }
    },
    {
      "type": "telegram",
      "name": "telegram",
      "options": {
        "token": "123456:ABC-xxxx",
        "allowUsers": []
      }
    },
    {
      "type": "slack",
      "name": "slack",
      "options": {
        "botToken": "xoxb-xxxx",
        "appToken": "xapp-xxxx"
      }
    },
    {
      "type": "discord",
      "name": "discord",
      "options": {
        "token": "MTIzxxxx"
      }
    }
  ],
  "agents": [
    {
      "name": "helper",
      "provider": "openai",
      "model": "gpt-4o-mini",
      "apiKey": "sk-xxxx",
      "baseUrl": "https://api.openai.com/v1",
      "system": "You are chatmux, a helpful chat assistant. Reply in the user's language, keep it concise.",
      "routes": [
        { "channel": "any" }
      ]
    },
    {
      "name": "coder",
      "provider": "anthropic",
      "model": "claude-sonnet-4-5",
      "apiKey": "sk-ant-xxxx",
      "system": "You are a senior engineer. Answer with code first, explanation second.",
      "routes": [
        { "channel": "telegram", "chatType": "group" }
      ]
    },
    {
      "name": "dev",
      "cli": {
        "type": "claude",
        "model": "sonnet",
        "workingDir": "/srv/project"
      },
      "groupMention": true,
      "routes": [
        { "channel": "feishu", "chatId": "oc_xxxx" }
      ]
    }
  ],
  "cron": [
    {
      "name": "standup",
      "schedule": "30 9 * * 1-5",
      "channel": "feishu",
      "chatId": "oc_xxxx",
      "text": "请总结过去一天的工作进展和今天的计划。"
    }
  ],
  "workflows": [
    {
      "name": "translate-polish",
      "desc": "翻译再润色",
      "steps": [
        { "agent": "helper", "prompt": "把 {{input}} 翻译成英文" },
        { "agent": "coder", "prompt": "润色这段译文，只输出最终版本：{{prev}}" }
      ]
    }
  ]
}
