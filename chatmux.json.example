{
  "http": {
    "listen": "127.0.0.1:8080",
    "adminToken": "set-a-long-random-string-if-exposed"
  },
  "dataDir": "data",
  "skillsDir": "skills",
  "transcribe": { "enabled": true, "model": "whisper-1" },
  "defaultAgent": "helper",
  "channels": [
    {
      "type": "feishu",
      "name": "feishu",
      "options": {
        "appId": "cli_xxxx",
        "appSecret": "xxxx",
        "mode": "ws",
        "allowUsers": ["ou_xxxx"],
        "allowChats": []
      }
    },
    {
      "type": "dingtalk",
      "name": "dingtalk",
      "options": {
        "clientId": "dingxxxx",
        "clientSecret": "xxxx",
        "allowUsers": []
      }
    },
    {
      "type": "wecom",
      "name": "wecom",
      "options": {
        "corpId": "wwxxxx",
        "agentId": 1000002,
        "secret": "xxxx",
        "token": "xxxx",
        "encodingAesKey": "43chars",
        "callbackPath": "/wecom/callback",
        "allowUsers": []
      }
    },
    {
      "type": "telegram",
      "name": "telegram",
      "options": {
        "token": "123456:ABC-xxxx",
        "allowUsers": []
      }
    },
    {
      "type": "slack",
      "name": "slack",
      "options": {
        "botToken": "xoxb-xxxx",
        "appToken": "xapp-xxxx"
      }
    },
    {
      "type": "discord",
      "name": "discord",
      "options": {
        "token": "MTIzxxxx"
      }
    }
  ],
  "agents": [
    {
      "name": "helper",
      "provider": "openai",
      "model": "gpt-4o-mini",
      "apiKey": "sk-xxxx",
      "baseUrl": "https://api.openai.com/v1",
      "system": "You are chatmux, a helpful chat assistant. Reply in the user's language, keep it concise.",
      "routes": [
        { "channel": "any" }
      ]
    },
    {
      "name": "coder",
      "provider": "anthropic",
      "model": "claude-sonnet-4-5",
      "apiKey": "sk-ant-xxxx",
      "system": "You are a senior engineer. Answer with code first, explanation second.",
      "routes": [
        { "channel": "telegram", "chatType": "group" }
      ]
    },
    {
      "name": "dev",
      "cli": {
        "type": "claude",
        "model": "sonnet",
        "workingDir": "/srv/project",
        "sandbox": { "mode": "docker", "image": "node:20-slim", "network": "none" }
      },
      "groupMention": true,
      "routes": [
        { "channel": "feishu", "chatId": "oc_xxxx" }
      ]
    }
  ],
  "i18n": { "locale": "zh" },
  "cron": [
    {
      "name": "standup",
      "schedule": "30 9 * * 1-5",
      "channel": "feishu",
      "chatId": "oc_xxxx",
      "text": "请总结过去一天的工作进展和今天的计划。"
    }
  ],
  "workflows": [
    {
      "name": "translate-polish",
      "desc": "翻译再润色",
      "steps": [
        { "agent": "helper", "prompt": "把 {{input}} 翻译成英文" },
        { "agent": "coder", "prompt": "润色这段译文，只输出最终版本：{{prev}}" }
      ]
    }
  ],
  "forms": [
    {
      "name": "bug",
      "desc": "报 bug：填完提交，机器人会按内容处理",
      "fields": [
        { "name": "title", "label": "标题", "type": "input", "placeholder": "一句话描述", "required": true },
        { "name": "detail", "label": "详情", "type": "textarea" },
        { "name": "sev", "label": "严重程度", "type": "select", "options": ["低", "中", "高"] }
      ]
    }
  ],
  "docwatch": [
    {
      "name": "plan",
      "path": "docs/plan.md",
      "intervalSec": 60,
      "channel": "feishu",
      "chatId": "oc_xxxx",
      "prompt": "计划文档有更新，请总结变更并提醒相关事项：\n{{diff}}"
    }
  ],
  "oncall": {
    "members": ["张三", "李四", "王五"],
    "rotation": "daily",
    "anchor": "2026-11-01",
    "channel": "feishu",
    "chatId": "oc_xxxx"
  }
}
